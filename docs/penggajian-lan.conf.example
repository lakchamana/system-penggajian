# Contoh pengujian HTTP untuk Apache 2.4. Isi IP dan path sesuai PC server.
# Pertahankan vhost bawaan yang melayani pembayaran sebelum kedua blok ini.
# Aktifkan sebagai penggajian-lan.conf setelah disesuaikan.

<Directory "C:/apps/system-penggajian">
    Options -Indexes
    AllowOverride None
    Require all denied
</Directory>

<VirtualHost *:80>
    ServerName slip-gaji.intranet
    DocumentRoot "C:/apps/system-penggajian"
    SetEnv PAYROLL_PORTAL employee

    <Directory "C:/apps/system-penggajian">
        AllowOverride All
        Require all granted
    </Directory>
</VirtualHost>

<VirtualHost *:80>
    ServerName gaji-admin.intranet
    DocumentRoot "C:/apps/system-penggajian"
    SetEnv PAYROLL_PORTAL admin

    <Directory "C:/apps/system-penggajian">
        AllowOverride All
        Require ip 192.168.1.22
    </Directory>
</VirtualHost>
